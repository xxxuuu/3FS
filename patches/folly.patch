+template <class Error, class Value>
+constexpr Expected<typename std::decay<Value>::type, Error> makeExpected(
+    Value&& val) {
+  return Expected<typename std::decay<Value>::type, Error>{
+      in_place, static_cast<Value&&>(val)};
