+  void clear() noexcept {}
+  constexpr static bool uninitializedByException() noexcept { return false; }
+  template <class... Vs>
+  void assignValue(Vs&&... vs) {
+    expected_detail::doEmplaceAssign(0, value_, static_cast<Vs&&>(vs)...);
