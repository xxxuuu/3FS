+struct detect_promise_return_object_eager_conversion_ {
+  struct promise_type {
+    struct return_object {
+      /* implicit */ return_object(promise_type& p) noexcept : promise{&p} {
+        promise->object = this;
+      }
+      ~return_object() {
+        if (promise) {
+          promise->object = nullptr;
+        }
+      }
+
+      promise_type* promise;
+    };
+
+    ~promise_type() {
+      if (object) {
+        object->promise = nullptr;
+      }
+    }
+
