+/**
+ * swap Expected values
+ */
+template <class Value, class Error>
+void swap(Expected<Value, Error>& lhs, Expected<Value, Error>& rhs) noexcept(
+    expected_detail::StrictAllOf<IsNothrowSwappable, Value, Error>::value) {
+  lhs.swap(rhs);
+}
